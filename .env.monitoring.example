# Optional: copy to .env. Defaults work with Mailpit, no external email account needed.
LOG_LEVEL=INFO
MONITORING_API_PORT=18000
SMTP_HOST=mailpit:1025
SMTP_FROM=alerts@courtside.test
SMTP_TO=paul@courtside.test
SMTP_STARTTLS_POLICY=NoStartTLS
# For a real SMTP provider use its host, username and password, and enable TLS:
# SMTP_HOST=smtp.example.com:587
# SMTP_STARTTLS_POLICY=MandatoryStartTLS
# SMTP_USER=
# SMTP_PASSWORD=
# The real champion also needs MLFLOW_TRACKING_URI / USERNAME / PASSWORD in .env.
